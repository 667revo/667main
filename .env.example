# Bu dosya git'e dahildir — buraya GERÇEK DEĞER YAZMA.
# Kopyala: cp .env.example .env  ve değerleri .env içine gir (.env gitignore'da).

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Sunucuya sağ tık > Copy Server ID (Geliştirici modu açık olmalı)
GUILD_ID=

# Admin rolünün ID'si. Boş bırakılırsa aşağıdaki isim kullanılır.
ADMIN_ROLE_ID=

# ADMIN_ROLE_ID boşsa bu isimdeki rol admin sayılır.
ADMIN_ROLE_NAME=admin rolü

# Botun tepki-rol eşleşmelerini sakladığı kanal (üyelere kapalı bir kanal olsun).
# Heroku'da ZORUNLU: dosya sistemi kalıcı olmadığı için durum burada tutulur.
CONFIG_CHANNEL_ID=
